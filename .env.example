# Environment variables for local development

# Server
HOST=0.0.0.0
PORT=8080
DEBUG=true

# Auth
ROOT_KEY=sk-root-change-me

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opengateway

# Redis
REDIS_URL=redis://localhost:6379/0

# Providers
OPENAI_API_KEY=sk-your-openai-key

# Routes (issue #4): JSON array of {model, primary, fallback,
# input_price_per_1k, output_price_per_1k, max_output_tokens}.
# Empty/unset ⇒ prefix-based fallback (gpt-* → openai, claude-* → anthropic, ...).
# Example:
# ROUTES_JSON=[{"model":"gpt-4o-mini","primary":"openai","input_price_per_1k":0.00015,"output_price_per_1k":0.0006,"max_output_tokens":16384},{"model":"gpt-4o","primary":"openai","fallback":"anthropic","input_price_per_1k":0.0025,"output_price_per_1k":0.01,"max_output_tokens":4096}]

# Observability
LOG_LEVEL=DEBUG
